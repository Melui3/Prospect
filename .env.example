# ── Django ────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Token demande par le frontend pour charger les donnees reelles.
OWNER_ACCESS_TOKEN=change-me-to-a-long-private-token
# Active l'acces public aux donnees anonymisees de demonstration.
DEMO_MODE=True

# Mode appli locale/bureau. Utilisé par scripts/Start-Prospect.ps1.
DESKTOP_MODE=False
SERVE_FRONTEND=False
REQUIRE_OWNER_TOKEN=False
FRONTEND_DIST_DIR=desktop_static

# ── PostgreSQL ────────────────────────────────────────────────
DB_NAME=prospect_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# ── Email SMTP ────────────────────────────────────────────────
# Gmail : créez un "App Password" dans votre compte Google
# (Sécurité → Authentification 2 facteurs → Mots de passe d'application)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=votre@gmail.com
EMAIL_HOST_PASSWORD=votre_app_password
DEFAULT_FROM_EMAIL=votre@gmail.com
# Optionnel : livraison Brevo et envois avec identifiant de message.
# Sur Windows, cette cle et l'expediteur peuvent aussi etre saisis dans Reglages.
BREVO_API_KEY=

# ── CORS ──────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Scraping
OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://z.overpass-api.de/api/interpreter,https://lz4.overpass-api.de/api/interpreter
OVERPASS_TIMEOUT=25
OVERPASS_TOTAL_TIMEOUT=45
OVERPASS_ENDPOINT_TIMEOUT=18
ENRICHMENT_TOTAL_TIMEOUT=70
WEBSITE_EMAIL_MAX_LOOKUPS=30
WEBSITE_EMAIL_MAX_PAGES=5
WEBSITE_EMAIL_TIMEOUT=4
SOCIAL_SEARCH_MAX_LOOKUPS=20
SOCIAL_SEARCH_TIMEOUT=4
PAGES_JAUNES_MAX_LOOKUPS=30
PAGES_JAUNES_TIMEOUT=3
PAGES_JAUNES_DELAY_SECONDS=0.2
